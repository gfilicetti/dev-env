# =============================================================================
# ~/.screenrc — Classic GNU Screen Configuration (Part of Gino's Super Dev Env)
# =============================================================================
# Preserved for legacy screen sessions; primary multiplexer is ~/.tmux.conf.
# =============================================================================

# Visual bell instead of audible bell
vbell on

# Detach automatically on hangup
autodetach on

# Skip startup copyright page
startup_message off

# Detach message
pow_detach_msg "Screen session of \$LOGNAME \$:cr:\$:nl:ended."

# Login shell
shell -$SHELL

# Deep scrollback buffer (100,000 lines)
defscrollback 100000

# xterm tweaks
termcap  xterm hs@:cs=\E[%i%d;%dr:im=\E[4h:ei=\E[4l
terminfo xterm hs@:cs=\E[%i%p1%d;%p2%dr:im=\E[4h:ei=\E[4l
termcapinfo  xterm Z0=\E[?3h:Z1=\E[?3l:is=\E[r\E[m\E[2J\E[H\E[?7h\E[?1;4;6l
termcapinfo xterm* OL=10000
termcapinfo xterm 'VR=\E[?5h:VN=\E[?5l'
termcapinfo xterm 'k1=\E[11~:k2=\E[12~:k3=\E[13~:k4=\E[14~'
termcapinfo xterm 'kh=\E[1~:kI=\E[2~:kD=\E[3~:kH=\E[4~:kP=\E[H:kN=\E[6~'
termcapinfo xterm 'hs:ts=\E]2;:fs=\007:ds=\E]2;screen\007'
termcapinfo xterm 'vi=\E[?25l:ve=\E[34h\E[?25h:vs=\E[34l'
termcapinfo xterm 'XC=K%,%\E(B,[\304,\\\\\326,]\334,{\344,|\366,}\374,~\337'
termcapinfo xterm be

# Keybindings: remove dangerous defaults and bind K to kill
bind k
bind ^k
bind .
bind ^\
bind \\
bind ^h
bind h
bind 'K' kill
bind '}' history

# Autoindent-safe paste hack on ^a^]
register [ "\033:se noai\015a"
register ] "\033:se ai\015a"
bind ^] paste [.]

# Bottom hardstatus bar: [ hostname ][ windows ][ YYYY-MM-DD HH:MM ]
hardstatus alwayslastline
hardstatus string '%{= kG}[ %{G}%H %{g}][%= %{=kw}%?%-Lw%?%{r}(%{W}%n*%f%t%?(%u)%?%{r})%{w}%?%+Lw%?%?%= %{g}][%{B}%Y-%m-%d %{W}%c %{g}]'

# Default startup windows (customize window title as desired)
screen -t sh 0
screen -t sh 1
screen -t sh 2
screen -t sh 3
select 0
