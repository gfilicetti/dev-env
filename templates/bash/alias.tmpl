# =============================================================================
# ~/.alias — Gino's Super Dev Env
# =============================================================================
# Portable shell aliases & functions. Sourced by ~/.bash_profile and ~/.bashrc.
# Add machine-specific aliases to ~/.bashrc.local to keep this file clean.
# =============================================================================

# --- Disk, File & Editor Shortcuts -------------------------------------------
alias ducks="du -cks * | sort -rn | head -11"
alias edit='$EDITOR'
alias edal='$EDITOR ~/.alias'          # Edit ~/.alias
alias srcal='. ~/.alias'               # Reload ~/.alias
alias edsh='$EDITOR ~/.bashrc'         # Edit ~/.bashrc
alias srcsh='. ~/.bashrc'              # Reload ~/.bashrc
alias ednv='$EDITOR ~/.config/nvim/init.lua'
alias edtm='$EDITOR ~/.tmux.conf'
alias c="clear"                        # Clear the screen
alias ren="mv -i"                      # Rename with overwrite confirmation
alias cz="unzip -l"                    # List zip archive contents
alias m="less"
alias md="mkdir"
alias rd="rmdir"
if ls --color=auto >/dev/null 2>&1; then
    alias l="ls -Flh --color=auto"
else
    alias l="ls -Flh -G"
fi
alias nc="netcat"
alias macvim="mvim"
alias whatsmyip="curl -s 'https://api.ipify.org?format=json' | jq -r .ip"
alias python="python3"
alias pip="pip3"

# --- Antigravity Dev Environment Shortcuts -----------------------------------
alias tdev="ade"                       # Launch tmux + nvim + agy IDE layout
alias clip="dev-copy"                  # Universal clipboard helper (macOS/Linux/SSH OSC52)

# --- Cloud & Kubernetes Shortcuts --------------------------------------------
alias gc="gcloud"
alias mk="minikube"
if [ -f "$HOME/.alias_kubectl" ]; then
    source "$HOME/.alias_kubectl"
fi

# --- Git Shortcuts -----------------------------------------------------------
alias g="git"
alias gl="git pull"
alias gp="git push"
alias gf="git fetch --prune"
alias gs="git status"
alias gmm="git merge master"

# --- System & Maintenance Shortcuts (OS-Aware: macOS & Linux) ----------------
if [[ "$(uname -s)" == "Darwin" ]]; then
    # Customize backup script path in ~/.bashrc.local if needed:
    alias rback='sudo cat /dev/null && osascript "$HOME/applescript/rsync.applescript"'
    alias update="sudo softwareupdate -i -a; brew update; brew upgrade; brew cleanup; brew doctor"
else
    if command -v apt-get >/dev/null 2>&1; then
        alias update="sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get autoremove -y"
    elif command -v dnf >/dev/null 2>&1; then
        alias update="sudo dnf upgrade --refresh -y"
    elif command -v pacman >/dev/null 2>&1; then
        alias update="sudo pacman -Syu"
    elif command -v apk >/dev/null 2>&1; then
        alias update="sudo apk update && sudo apk upgrade"
    fi
fi
alias gn="geeknote"

# --- Helper Functions --------------------------------------------------------

# Open passed-in directory in file manager (Path Finder/Finder on macOS, xdg-open on Linux)
pf() {
    local target="${1:-.}"
    if [[ "$(uname -s)" == "Darwin" ]]; then
        if [ -d "/Applications/Path Finder.app" ]; then
            open -a "Path Finder.app" "$target"
        else
            open "$target"
        fi
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$target" >/dev/null 2>&1 &
    else
        echo "No graphical file manager found for: $target" >&2
        return 1
    fi
}

# Spell-check word(s) using aspell
checkword() {
    echo "$@" | aspell -a | sed -n -e '/^\&/p' -e '/^\#/p'
}

# Create a directory and immediately cd into it
mkcd() {
    mkdir -p "$*" && cd "$*"
}
