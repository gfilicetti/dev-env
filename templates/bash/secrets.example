# =============================================================================
# ~/.secrets — Private Environment Variables & API Tokens (UNTRACKED)
# =============================================================================
# Copy this file to ~/.secrets and set permissions to 600:
#   cp templates/bash/secrets.example ~/.secrets && chmod 600 ~/.secrets
#
# Never commit ~/.secrets to Git! It is sourced automatically by ~/.bash_profile
# and ~/.bashrc.
# =============================================================================

# GitHub Personal Access Token for Homebrew API rate limits
# export HOMEBREW_GITHUB_API_TOKEN="<YOUR_GITHUB_PAT_HERE>"

# Add any other private API keys or credentials below:
# export OPENAI_API_KEY="..."
# export GEMINI_API_KEY="..."
