# =============================================================================
# ~/.bash_profile — Gino's Super Dev Env (macOS & Linux)
# =============================================================================
# Sourced by login shells. Loads ~/.bashrc, ~/.alias, and untracked ~/.secrets.
# =============================================================================

# Silence macOS "The default interactive shell is now zsh" deprecation notice
export BASH_SILENCE_DEPRECATION_WARNING=1

# Ensure Homebrew (Apple Silicon & Intel) and user-local bins are on PATH early
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
export PATH=".:$HOME/bin:$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:$HOME/.dotnet/tools:$PATH"

# 1. Load interactive bash settings (Starship, fzf, history, EDITOR)
if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi

# 2. Load command aliases & helper functions
if [ -f "$HOME/.alias" ]; then
    . "$HOME/.alias"
fi

# 3. Load private tokens & secrets from untracked ~/.secrets (chmod 600)
#    Put HOMEBREW_GITHUB_API_TOKEN or other API keys in ~/.secrets
if [ -f "$HOME/.secrets" ]; then
    . "$HOME/.secrets"
fi

# 4. iTerm2 Shell Integration (macOS, if installed)
test -e "${HOME}/.iterm2_shell_integration.bash" && source "${HOME}/.iterm2_shell_integration.bash" || true

# 5. Cross-Platform Bash Completion (macOS Homebrew & Linux system completions)
if type brew &>/dev/null; then
    HOMEBREW_PREFIX="$(brew --prefix)"
    if [[ -r "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" ]]; then
        source "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
    else
        for COMPLETION in "${HOMEBREW_PREFIX}/etc/bash_completion.d/"*; do
            [[ -r "${COMPLETION}" ]] && source "${COMPLETION}"
        done
    fi
elif [ -r /usr/share/bash-completion/bash_completion ]; then
    source /usr/share/bash-completion/bash_completion
elif [ -r /etc/bash_completion ]; then
    source /etc/bash_completion
fi

# 6. Google Cloud SDK (GCP CLI) setup (macOS & Linux standard locations)
for GCLOUD_SDK_DIR in \
    "/usr/local/share/google-cloud-sdk" \
    "/opt/homebrew/share/google-cloud-sdk" \
    "/usr/share/google-cloud-sdk" \
    "/usr/lib/google-cloud-sdk" \
    "/snap/google-cloud-cli/current" \
    "$HOME/google-cloud-sdk"; do
    if [ -d "$GCLOUD_SDK_DIR" ]; then
        [ -f "$GCLOUD_SDK_DIR/path.bash.inc" ] && source "$GCLOUD_SDK_DIR/path.bash.inc"
        [ -f "$GCLOUD_SDK_DIR/completion.bash.inc" ] && source "$GCLOUD_SDK_DIR/completion.bash.inc"
        [ -d "$GCLOUD_SDK_DIR/bin" ] && export PATH="$PATH:$GCLOUD_SDK_DIR/bin"
        break
    fi
done

# 7. pip bash completion
_pip_completion() {
    COMPREPLY=( $( COMP_WORDS="${COMP_WORDS[*]}" \
                   COMP_CWORD=$COMP_CWORD \
                   PIP_AUTO_COMPLETE=1 $1 ) )
}
complete -o default -F _pip_completion pip

# 8. Optional language version managers (uncomment if needed)
# eval "$(jenv init -)"
# eval "$(pyenv init -)"

# 9. Vi keybindings on the command line
set -o vi

# 10. Optional Multiplexer Startup Prompt (configured by install.sh: tmux | screen | none)
MULTIPLEXER_MODE="{{MULTIPLEXER_PROMPT}}"
if [[ $- == *i* ]] && [ -z "${TMUX:-}" ] && [ "$TERM" != "screen.xterm-256color" ] && [ "$TERM" != "dumb" ]; then
    if [ "$MULTIPLEXER_MODE" = "tmux" ] && command -v tmux >/dev/null 2>&1; then
        read -t 5 -p "Start tmux? (y/N) " ans || true
        ans=$(echo "${ans:-}" | tr '[:upper:]' '[:lower:]')
        if [[ "$ans" = "y" || "$ans" = "yes" ]]; then
            tmux new-session -A -s main
        fi
    elif [ "$MULTIPLEXER_MODE" = "screen" ] && command -v screen >/dev/null 2>&1; then
        read -t 5 -p "Start screen? (y/N) " ans || true
        ans=$(echo "${ans:-}" | tr '[:upper:]' '[:lower:]')
        if [[ "$ans" = "y" || "$ans" = "yes" ]]; then
            screen -D -RR
        fi
    fi
fi
